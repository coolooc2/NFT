{
  "name": "pixel-nft-marketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && yarn dev",
    "dev:backend": "cd backend && yarn dev",
    "dev": "concurrently \"yarn dev:frontend\" \"yarn dev:backend\"",
    "build:frontend": "cd frontend && yarn build",
    "build:backend": "cd backend && yarn build",
    "start:frontend": "cd frontend && yarn start",
    "start:backend": "cd backend && yarn start",
    "install:all": "yarn install && cd frontend && yarn install && cd ../backend && yarn install",
    "test:contracts": "cd contracts && yarn test",
    "compile:contracts": "cd contracts && yarn compile",
    "deploy:contracts": "cd contracts && yarn deploy",
    "lint": "cd frontend && yarn lint && cd ../backend && yarn lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/morgan": "^1.9.9",
    "concurrently": "^8.2.2",
    "hardhat": "^2.23.0",
    "prettier": "^2.8.8",
    "sharp": "^0.32.6"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^5.17.1",
    "@reown/appkit": "^1.7.3",
    "@reown/appkit-adapter-wagmi": "^1.7.3",
    "@tanstack/react-query": "^5.74.11",
    "@types/cookie-parser": "^1.4.8",
    "@types/react": "^18.3.20",
    "cookie-parser": "^1.4.7",
    "react-router-dom": "^7.5.3",
    "viem": "^2.28.1",
    "wagmi": "^2.15.1"
  },
  "description": "A decentralized NFT marketplace built with React, TypeScript, and Solidity.",
  "main": "hardhat.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
